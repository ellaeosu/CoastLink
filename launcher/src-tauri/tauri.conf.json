{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoastLink",
  "version": "0.6.4",
  "identifier": "org.coastlink.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CoastLink",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#000000",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "copyright": "GPL-3.0-or-later. Built on OpenSmash-Ultimate (ssbu-recomp).",
    "shortDescription": "Rollback netplay launcher"
  }
}
